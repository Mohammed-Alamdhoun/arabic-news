# Copy this file to `.env` and fill in real values.

# OpenRouter (used by Stage 1 LLM word-boundary fixer)
OPENROUTER_API_KEY=

# Optional: switch the LLM model used by the fixer
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# OpenAI (used by LLMSummarizer — fixes merged words + faithful summary, on demand)
OPENAI_API_KEY=

# Optional: override the summary model (default: gpt-4o-mini)
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
