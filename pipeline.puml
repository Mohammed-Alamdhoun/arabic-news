@startuml pipeline
title Arabic News Semantic Intelligence Pipeline

skinparam backgroundColor #0F1115
skinparam shadowing false
skinparam defaultFontColor #E6E6E6
skinparam ArrowColor #9AA0A6
skinparam ArrowFontColor #C8CDD2
skinparam rectangle {
  BorderColor #4A4F57
  FontColor #E6E6E6
}
skinparam package {
  BorderColor #6B7280
  FontColor #FFFFFF
  BackgroundColor #161A20
}

' ============ Stage 0 ============
package "Stage 0 · Scraping" as S0 {
  rectangle "Scrapy Spider\naljazeera.net" as s0a
  rectangle "16,191 raw articles" as s0b
}

' ============ Stage 1 ============
package "Stage 1 · Clean + LLM Fix" as S1 {
  rectangle "HTML strip · NFKC · SimHash dedup" as s1a
  rectangle "Gemini word-boundary fix" as s1b
  rectangle "fixed.jsonl · 8,635 articles" as s1c
}

' ============ Stage 2 ============
package "Stage 2 · Splitter Dataset" as S2 {
  rectangle "500k sentences\nSPLIT / JOIN labels" as s2a
  database "train 400k\ndev 25k · test 25k" as s2b
}

' ============ Stage 3 ============
package "Stage 3 · AraBERT Splitter" as S3 {
  rectangle "AraBERTv2 · 110M" as s3a
  database "splitter checkpoint\n~538 MB · F1 ≈ 0.9827" as s3b
}

' ============ Stage 4 ============
package "Stage 4 · Apply Splitter (optional)" as S4 {
  rectangle "Insert spaces at\nhigh-confidence SPLITs" as s4a
  rectangle "splitter_applied.jsonl · 8,635 articles" as s4b
}

' ============ Stage 5 ============
package "Stage 5 · NLP Preprocessing" as S5 {
  rectangle "1. Num/Date normalize\n2. Unicode (Alef/Teh)\n3. MLE disambiguator lemmatize\n4. Customized Stopwords" as s5a
}

' ============ Stage 6 ============
package "Stage 6 · Linguistic Artifacts" as S6 {
  rectangle "embedding_view (E5)" as s6a
  rectangle "clustering_view (mask_numbers)" as s6b
  rectangle "lemmas (TF-IDF / search)" as s6c
}

' ============ Stage 7 ============
package "Stage 7 · E5 Embeddings" as S7 {
  rectangle "E5-large · 560M" as s7a
  database "emb_large.npy\n8,635 x 1,024" as s7b
}

' ============ Stage 8 ============
package "Stage 8 · BERTopic" as S8 {
  rectangle "UMAP 1024 -> 5" as s8a
  rectangle "HDBSCAN\nmin_cluster=20 · min_samples=10" as s8b
  rectangle "c-TF-IDF + merge (cos > 0.85)" as s8c
  rectangle "clusters.jsonl · 20 topics\nNPMI 0.328 · Silhouette 0.095 · 707 noise" as s8d
}

' ============ Stage 9 ============
package "Stage 9 · Semantic Search" as S9 {
  rectangle "Arabic query -> E5 encode" as s9a
  rectangle "Brute-force cosine k-NN\n8,635 vectors · numpy (in-memory)" as s9b
  rectangle "Ranked results + topic filter" as s9c
}

' ============ Stage 10 ============
package "Stage 10 · Summarization" as S10 {
  rectangle "A · Extractive Summarization\nTextRank + MMR" as s10a
  rectangle "B · LLM Abstractive Summarization\ngpt-4o-mini" as s10b
}

' ============ Stage 11 ============
package "Stage 11 · Evaluation" as S11 {
  rectangle "ROUGE 1/2/L\nn-gram overlap" as s11a
  rectangle "Grounding\nsentence traceability" as s11b
  rectangle "Number Halluc.\nnumeric tokens" as s11c
  rectangle "Distinct-1/2\ndiversity" as s11d
  rectangle "Novel Content\nnew n-grams" as s11e
  rectangle "Redundancy\ncompression" as s11f
  rectangle "eval_results.json" as s11g
}

' ============ Stage 12 ============
package "Stage 12 · Streamlit App" as S12 {
  rectangle "Tab 1 · Semantic Search\nquery -> E5 -> ranked cards + topic filter + summary" as s12a
  rectangle "Tab 2 · 3D Topic Galaxy\nPlotly scatter3d · hover details\nreuses UMAP (3D projection)" as s12b
}

' ============ Flow ============
S0 --> S1
S1 --> S2 : sample
S2 --> S3 : train
S3 --> S4 : checkpoint
S1 ..> S4 : fixed articles
S4 --> S5
S5 --> S6 : 3 views
S6 --> S7 : embedding_view
S7 --> S8 : vectors
S8 --> S9 : topic labels
S9 --> S10 : article
S10 --> S11 : summaries
S11 --> S12 : eval scores
S10 ..> S12 : summaries
S8 ..> S12 : topics

@enduml
